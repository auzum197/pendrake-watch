{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the detached Verify window (prototype)",
  "windows": ["main", "verify"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "opener:default",
    "deep-link:default"
  ]
}
